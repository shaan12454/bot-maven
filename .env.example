# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here

# Railway PostgreSQL (auto-filled by Railway when you add a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/railway

# API Security — use a long random string
API_SECRET=replace_this_with_a_long_random_secret

# Your Lovable dashboard URL (for CORS)
DASHBOARD_ORIGIN=https://your-app.lovable.app

# Port for the API server (Railway sets this automatically)
PORT=8080
